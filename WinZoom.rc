// WinZoom.rc - アイコンとバージョン情報
#include <windows.h>

IDI_APP ICON "WinZoom.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Imaha486"
            VALUE "FileDescription",  "WinZoom - per-window magnifier"
            VALUE "FileVersion",      "1.0.0"
            VALUE "InternalName",     "WinZoom"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Imaha486. MIT License."
            VALUE "OriginalFilename", "WinZoom.exe"
            VALUE "ProductName",      "WinZoom"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
